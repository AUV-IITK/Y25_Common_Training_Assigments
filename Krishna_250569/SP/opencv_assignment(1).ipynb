        "## 1. Reading Images and Videos\n",
        "**Task:**\n",
        "1. Read the image `cats.jpg` and display it.\n",
        "2. Read the video `dog.mp4` and display it frame by frame. Ensure the video window closes when the 'd' key is pressed."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "CVznITJrUbz7"
      },
      "outputs": [],
      "source": [
        "import cv2 as cv
import sys

img = cv.imread('cat.jpg')
if img is None:
    sys.exit("Could not read the image 'cat.jpg'. Check path!")

cv.imshow('Cat Image', img)
cv.waitKey(0)
cv.destroyAllWindows()

capture = cv.VideoCapture('dog.mp4')

while True:
    isTrue, frame = capture.read()
    
    
    if not isTrue:
        print("Video frames ended or file not found.")
        break
        
    cv.imshow('Dog Video', frame)
    
    if cv.waitKey(20) & 0xFF == ord('d'):
        break

capture.release()
cv.destroyAllWindows()"
      ]
