        "## 9. Thresholding\n",
        "**Task:**\n",
        "1. Load `cats.jpg` and convert to grayscale.\n",
        "2. Apply Simple Thresholding (Binary and Inverse)."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "q6EnC2niUb0D"
      },
      "outputs": [],
      "source": [
        "import cv2 as cv
import sys


img = cv.imread('cat.jpg')
if img is None:
    sys.exit("Could not read 'cat.jpg'.")
gray = cv.cvtColor(img, cv.COLOR_BGR2GRAY)


# Threshold value set to 150, max value set to 255
threshold_val = 150
max_val = 255

threshold, thresh_binary = cv.threshold(gray, threshold_val, max_val, cv.THRESH_BINARY)
threshold_inv, thresh_binary_inv = cv.threshold(gray, threshold_val, max_val, cv.THRESH_BINARY_INV)

cv.imshow('Grayscale Image', gray)
cv.imshow('Simple Threshold Binary', thresh_binary)
cv.imshow('Simple Threshold Binary Inverse', thresh_binary_inv)

cv.waitKey(0)
cv.destroyAllWindows()"
      ]
