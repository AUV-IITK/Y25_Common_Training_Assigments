        "## 4. Image Transformations\n",
        "**Task:**\n",
        "1. Create a function `translate(img, x, y)` to shift an image.\n",
        "2. Create a function `rotate(img, angle, rotPoint=None)` to rotate an image.\n",
        "3. Apply a flip transformation to `park.jpg`."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "Ymr_EfIYUb0A"
      },
      "outputs": [],
      "source": [
        "import cv2 as cv
import numpy as np
import sys

img = cv.imread('park.jpg')
if img is None:
    sys.exit("Could not read 'park.jpg'.")


def translate(img, x, y):
    transMat = np.float32([[1, 0, x], [0, 1, y]])
    dimensions = (img.shape[1], img.shape[0]) # (width, height)
    return cv.warpAffine(img, transMat, dimensions)


def rotate(img, angle, rotPoint=None):
    (height, width) = img.shape[:2]
    if rotPoint is None:
        rotPoint = (width // 2, height // 2)
        
    rotMat = cv.getRotationMatrix2D(rotPoint, angle, 1.0)
    dimensions = (width, height)
    return cv.warpAffine(img, rotMat, dimensions)

# Apply functions
translated_img = translate(img, -100, 50)  # shift left 100px, down 50px
rotated_img = rotate(img, 45)              # rotate 45 degrees counter-clockwise



flipped_img = cv.flip(img, 1)

cv.imshow('Translated', translated_img)
cv.imshow('Rotated', rotated_img)
cv.imshow('Flipped Horizontally', flipped_img)

cv.waitKey(0)
cv.destroyAllWindows()"
      ]
