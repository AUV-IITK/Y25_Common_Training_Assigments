        "## 5. Contour Detection\n",
        "**Task:**\n",
        "1. Load `cats.jpg`.\n",
        "2. Convert to grayscale and apply Gaussian blur.\n",
        "3. Find the edges using Canny.\n",
        "4. Use `cv.findContours` to find all contours.\n",
        "5. Print the count and draw them on a blank image."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "OUhOPkzLUb0A"
      },
      "outputs": [],
      "source": [
        "import cv2 as cv
import numpy as np
import sys


img = cv.imread('cat.jpg')
if img is None:
    sys.exit("Could not read 'cat.jpg'.")


gray = cv.cvtColor(img, cv.COLOR_BGR2GRAY)
blur = cv.GaussianBlur(gray, (5, 5), cv.BORDER_DEFAULT)


canny = cv.Canny(blur, 125, 175)


# cv.RETR_LIST returns all contours; cv.CHAIN_APPROX_SIMPLE compresses horizontal, vertical, and diagonal segments
contours, hierarchies = cv.findContours(canny, cv.RETR_LIST, cv.CHAIN_APPROX_SIMPLE)


print(f'Total Contours Found: {len(contours)}')

blank = np.zeros(img.shape, dtype='uint8')
cv.drawContours(blank, contours, -1, (0, 255, 0), thickness=1)

cv.imshow('Canny Edges Used', canny)
cv.imshow('Drawn Contours', blank)
cv.waitKey(0)
cv.destroyAllWindows()"
      ]
