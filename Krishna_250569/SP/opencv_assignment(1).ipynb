        "## 8. Bitwise Operations\n",
        "**Task:**\n",
        "1. Create a $400 \\times 400$ blank image.\n",
        "2. Create a rectangle and a circle on separate blank images.\n",
        "3. Perform Bitwise AND, OR, XOR, and NOT."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "pHHrKLHVUb0C"
      },
      "outputs": [],
      "source": [
        "import cv2 as cv
import numpy as np


blank_rect = np.zeros((400, 400), dtype='uint8')
blank_circle = np.zeros((400, 400), dtype='uint8')


rectangle = cv.rectangle(blank_rect, (30, 30), (370, 370), 255, thickness=-1)
circle = cv.circle(blank_circle, (200, 200), 200, 255, thickness=-1)

cv.imshow('Rectangle Base', rectangle)
cv.imshow('Circle Base', circle)


bitwise_and = cv.bitwise_and(rectangle, circle)
bitwise_or = cv.bitwise_or(rectangle, circle)
bitwise_xor = cv.bitwise_xor(rectangle, circle)
bitwise_not = cv.bitwise_not(rectangle)

cv.imshow('Bitwise AND', bitwise_and)
cv.imshow('Bitwise OR', bitwise_or)
cv.imshow('Bitwise XOR', bitwise_xor)
cv.imshow('Bitwise NOT (Rectangle)', bitwise_not)

cv.waitKey(0)
cv.destroyAllWindows()"
      ]
